# This is an example environment file.
# Copy this file to .env and fill in your actual credentials.
# This file is safe to commit to version control.
# The .env file (which should be in your .gitignore) is NOT.

# --- FOFA Credentials ---

# Your FOFA account email
FOFA_EMAIL=your_fofa_email@example.com

# Your FOFA account API key
FOFA_KEY=your_fofa_api_key
